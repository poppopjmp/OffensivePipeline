<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects are executables: the runner is linked into the test assembly. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1861;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OffensivePipeline\OffensivePipeline.csproj" />
  </ItemGroup>

  <!--
    The shipped templates and resource files are linked rather than copied into the repository a
    second time, so the tests always assert against the exact files that ship. Nothing under
    OffensivePipeline/Tools is ever edited or duplicated.
  -->
  <ItemGroup>
    <None Include="..\..\OffensivePipeline\Tools\**\*.yml" LinkBase="Tools"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\OffensivePipeline\Resources\**\*" LinkBase="Resources"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      The SDK's DefaultItemExcludes drops **/*.sln, so the solution fixtures have to be included
      explicitly rather than updated. They are checked in with fixed CRLF and LF line endings, which
      is precisely what the reader has to cope with, so they must not be generated at build time.
    -->
    <None Include="Fixtures/*.sln" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
