<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-external" value="ExternalResources" />
  </packageSources>
  <!--
    Package source mapping pins the vendored DonutCore package to the local folder feed.
    The "DonutCore" ID is unclaimed on nuget.org, so without this mapping restore could be
    redirected to a squatted package published under that ID (dependency confusion).
  -->
  <packageSourceMapping>
    <packageSource key="local-external">
      <package pattern="DonutCore" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
