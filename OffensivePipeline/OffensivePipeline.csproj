<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>OffensivePipeline.Program</StartupObject>
    <NoWin32Manifest>true</NoWin32Manifest>
    <Version>3.0.0</Version>
    <Authors>aetsu, van1sh</Authors>
    <Product>OffensivePipeline</Product>
    <Description>Download, build, obfuscate and generate shellcode from C# offensive tooling in a single automated pipeline.</Description>
    <RepositoryUrl>https://github.com/poppopjmp/offensivepipeline</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Declared so the committed packages.lock.json always contains the win-x64 graph. Without
         this the lock file is RID-agnostic, and the RID publish that CI and release.yml run does
         its own restore that appends a net10.0/win-x64 section, dirtying a committed file and
         breaking the next locked-mode restore with NU1004. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DonutCore" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!--
    The pipeline's own types are internal by design; the test project reaches them directly rather
    than forcing an artificial public surface to exist purely so it can be asserted on.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OffensivePipeline.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Tools\**\*.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
